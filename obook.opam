# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis:
  "Zero-allocation L3 limit order book, 128-bit fixed-point math, and streaming HFT microstructure in pure OCaml"
description:
  "Obook is a dependency-free, zero-allocation L3 matching engine and quantitative microstructure toolkit for OCaml. Features overflow-proof 64-bit fixed-point arithmetic (10^-8 scale), pre-allocated arena order books with O(1) cancel/modify, Iceberg/FOK/IOC/Post-Only/STP execution semantics, NASDAQ ITCH 5.0 wire parsing, and numerically stable streaming indicators (Welford, Finch EWMA, Cont OFI, VPIN, Roll spread)."
maintainer: ["Abhradeep Basak <abhradeepbasak07@gmail.com>"]
authors: ["Abhradeep Basak <abhradeepbasak07@gmail.com>"]
license: "MIT"
homepage: "https://github.com/cryogenicdeadfrost/obook"
bug-reports: "https://github.com/cryogenicdeadfrost/obook/issues"
depends: [
  "ocaml" {>= "4.13.0"}
  "dune" {>= "2.9" & >= "2.9"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "--promote-install-files=false"
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
  ["dune" "install" "-p" name "--create-install-files" name]
]
dev-repo: "git+https://github.com/cryogenicdeadfrost/obook.git"
